{
  "config": {
    "minConfidence": 3,
    "maxSkills": 5,
    "showMatchReasons": true
  },
  "scoreWeights": {
    "keyword": 2,
    "keywordPattern": 3,
    "pathPattern": 4,
    "directoryMatch": 5,
    "intentPattern": 4,
    "contentPattern": 3
  },
  "directoryMappings": {
    "pkg/ai": "pkg-usage",
    "pkg/cache": "pkg-usage",
    "pkg/zsync": "pkg-usage",
    "pkg/filesystem": "pkg-usage",
    "pkg/zlog": "pkg-usage",
    "pkg/zhttp": "pkg-usage",
    "pkg/options": "pkg-usage",
    "pkg/messagebus": "pkg-usage",
    "pkg/docstore": "pkg-usage",
    "pkg/tui": "pkg-usage",
    "transport/grpc": "connectrpc-patterns",
    "proto/": "connectrpc-patterns",
    "gen/proto": "connectrpc-patterns",
    "repository/postgres": "database-patterns",
    "repository/sqlite": "database-patterns",
    "repository/mongodb": "database-patterns",
    "migrations/": "database-patterns",
    "frontend/src": "react-tailwind",
    "web/": "react-tailwind",
    "ui/": "react-tailwind"
  },
  "skills": {
    "go-error-handling": {
      "description": "Sentinel errors, wrapping, logging at boundaries, context via select",
      "priority": 9,
      "triggers": {
        "keywords": ["error", "err", "wrap", "sentinel", "Errorf", "ErrCanceled"],
        "keywordPatterns": ["\\berr\\b", "\\bErr[A-Z]\\w+"],
        "pathPatterns": ["**/*.go"],
        "contentPatterns": ["fmt\\.Errorf", "errors\\.New", "errors\\.Is"],
        "intentPatterns": [
          "(?:handle|wrap|create|define).*error",
          "error.*(?:handling|pattern)"
        ]
      }
    },
    "go-interfaces": {
      "description": "Consumer-side, small, composition, satisfaction checks",
      "priority": 8,
      "triggers": {
        "keywords": ["interface", "abstraction", "dependency", "inject"],
        "contentPatterns": ["type.*interface", "var _ .* = "],
        "intentPatterns": [
          "(?:design|create|define).*interface",
          "(?:inject|abstract).*dependency"
        ]
      }
    },
    "go-testing": {
      "description": "Table-driven, fakes over mocks, contract tests, synctest",
      "priority": 8,
      "triggers": {
        "keywords": ["test", "testing", "fake", "fixture", "benchmark"],
        "pathPatterns": ["**/*_test.go"],
        "contentPatterns": ["func Test", "t\\.Run", "t\\.Error", "t\\.Context"],
        "intentPatterns": [
          "(?:write|add|create).*test",
          "test.*(?:for|coverage)"
        ]
      }
    },
    "go-concurrency": {
      "description": "Goroutine lifecycle, channels, sync primitives, worker pools",
      "priority": 8,
      "triggers": {
        "keywords": ["goroutine", "channel", "mutex", "waitgroup", "concurrent", "parallel", "sync", "race"],
        "keywordPatterns": ["\\bgo\\s+func", "\\bchan\\b", "\\bsync\\."],
        "pathPatterns": ["**/*.go"],
        "contentPatterns": ["go func", "sync\\.Mutex", "sync\\.WaitGroup", "make\\(chan"],
        "intentPatterns": [
          "(?:add|implement|create).*(?:concurrent|parallel|goroutine)",
          "(?:worker|pool).*(?:pattern|goroutine)",
          "(?:race|deadlock).*(?:condition|issue)"
        ]
      }
    },
    "go-naming": {
      "description": "Scope-based naming, receivers, constants, no Get/Set",
      "priority": 7,
      "triggers": {
        "keywords": ["naming", "convention", "receiver", "constant", "variable"],
        "pathPatterns": ["**/*.go"],
        "intentPatterns": [
          "(?:name|naming|call).*(?:variable|function|method)",
          "what.*(?:call|name)"
        ]
      }
    },
    "go-types": {
      "description": "Semantic types, pointer rules, type aliases, sensible defaults",
      "priority": 7,
      "triggers": {
        "keywords": ["type", "pointer", "struct", "alias"],
        "pathPatterns": ["**/*.go"],
        "contentPatterns": ["type.*struct", "type.*="],
        "intentPatterns": ["(?:design|create).*(?:type|struct)"]
      }
    },
    "systematic-debugging": {
      "description": "Root cause first, no blind fixes, four-phase framework",
      "priority": 9,
      "triggers": {
        "keywords": ["bug", "debug", "fix", "error", "issue", "broken", "crash", "failing"],
        "intentPatterns": [
          "(?:fix|debug|investigate).*(?:bug|error|issue)",
          "(?:why|what).*(?:failing|broken|error)",
          "not working"
        ]
      }
    },
    "connectrpc-patterns": {
      "description": "Proto design, buf generation, service handlers, streaming",
      "priority": 8,
      "triggers": {
        "keywords": ["connectrpc", "grpc", "proto", "protobuf", "buf"],
        "pathPatterns": ["**/*.proto", "**/buf.yaml", "**/buf.gen.yaml", "**/*connect*.go"],
        "contentPatterns": ["connectrpc.com/connect", "syntax.*proto3", "buf generate"],
        "intentPatterns": [
          "(?:create|add).*(?:rpc|grpc|proto)",
          "(?:generate|buf).*proto"
        ]
      }
    },
    "database-patterns": {
      "description": "sqlc, migrations, repositories, in-memory fakes",
      "priority": 7,
      "triggers": {
        "keywords": ["database", "repository", "migration", "sqlc", "postgres", "sqlite", "mongodb"],
        "pathPatterns": ["**/migrations/*.sql", "**/queries/*.sql", "**/sqlc.yaml", "**/repository/*.go"],
        "contentPatterns": ["pgxpool", "sqlc", "goose", "ErrNoRows"],
        "intentPatterns": [
          "(?:create|add).*(?:migration|table)",
          "(?:database|db).*(?:query|pattern)"
        ]
      }
    },
    "pkg-usage": {
      "description": "Shared package import patterns, dependency layers",
      "priority": 6,
      "triggers": {
        "keywords": ["package", "import", "pkg", "shared"],
        "pathPatterns": ["**/pkg/**/*.go"],
        "contentPatterns": ["github.com/zarldev/zarlmono/pkg", "pkg/cache", "pkg/options", "pkg/zsync"],
        "intentPatterns": [
          "(?:use|import).*(?:package|pkg)",
          "which.*package"
        ]
      }
    },
    "react-tailwind": {
      "description": "Tailwind v4, theme-aware colors, component patterns",
      "priority": 6,
      "triggers": {
        "keywords": ["react", "tailwind", "component", "styling", "frontend"],
        "pathPatterns": ["**/*.tsx", "**/*.jsx", "**/tailwind.config.*", "**/index.css"],
        "contentPatterns": ["className=", "bg-primary", "text-foreground"],
        "intentPatterns": [
          "(?:create|style|build).*component",
          "(?:tailwind|css).*(?:class|style)"
        ]
      }
    },
    "connectrpc-web": {
      "description": "ConnectRPC web client patterns for React frontends",
      "priority": 6,
      "triggers": {
        "keywords": ["api", "fetch", "query", "mutation", "tanstack", "react-query"],
        "keywordPatterns": ["\\buse(?:Query|Mutation)\\b", "\\bclient\\b"],
        "pathPatterns": ["**/hooks/use*.ts", "**/gen/**/*_connect.ts"],
        "intentPatterns": [
          "(?:call|fetch|query).*api",
          "(?:create|use).*(?:hook|client)"
        ]
      }
    },
    "clerk-auth": {
      "description": "Clerk authentication patterns for React and Go",
      "priority": 6,
      "triggers": {
        "keywords": ["auth", "authentication", "clerk", "login", "user", "session", "jwt"],
        "keywordPatterns": ["\\bauth(?:entication)?\\b", "\\bclerk\\b", "\\blogin\\b"],
        "pathPatterns": ["**/auth/**/*", "**/middleware/**/*"],
        "intentPatterns": [
          "(?:add|implement).*auth",
          "(?:protect|secure).*route",
          "(?:check|verify).*(?:user|token)"
        ]
      }
    }
  }
}
